# Copy to .env and fill in. Never commit the real .env.
# All are optional; the defaults collect every namespace to /tmp.
# NAMESPACES=            # space-separated; empty = all namespaces
# LOG_TAIL_LINES=2000    # log lines per container
# INCLUDE_PREVIOUS=true  # also grab previous-container (crash) logs
# OUTPUT_DIR=/tmp        # where the tarball lands
# BUNDLE_S3_URI=         # optional s3://bucket/prefix upload target
